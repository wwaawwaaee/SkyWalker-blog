---
import { SITE_TITLE } from '../consts';

interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;

const navItems = [
  { href: '/', label: '首页', active: currentPath === '/' },
  { href: '/about', label: '关于', active: currentPath === '/about' },
  { href: '/publication', label: '发表', active: currentPath.startsWith('/publication') },
  { href: '/blog', label: '文章', active: currentPath.startsWith('/blog') },
];
---

<header class="site-nav-wrapper">
  <nav class="site-nav" aria-label="主导航">
    <a href="/" class="brand-lockup" aria-label={`${SITE_TITLE} 首页`}>
      <img src="/img/logo.png" alt="" class="brand-mark" aria-hidden="true" />
      <span class="brand-copy">
        <span class="brand-title">SkyWalker</span>
      </span>
    </a>

    <div class="nav-pill" role="list">
      {navItems.map((item) => (
        <a href={item.href} class:list={['nav-link', { active: item.active }]} aria-current={item.active ? 'page' : undefined}>
          <span>{item.label}</span>
        </a>
      ))}
    </div>

    <button type="button" class="theme-toggle" aria-label="切换主题">
      <span class="theme-icon sun" aria-hidden="true">
        <svg viewBox="0 0 24 24" focusable="false" role="img">
          <path d="M12 6.9a5.1 5.1 0 1 0 0 10.2 5.1 5.1 0 0 0 0-10.2Z"></path>
          <path d="M12 1.8c.5 0 .9.4.9.9v1.35a.9.9 0 1 1-1.8 0V2.7c0-.5.4-.9.9-.9Z"></path>
          <path d="M12 19.05c.5 0 .9.4.9.9v1.35a.9.9 0 1 1-1.8 0v-1.35c0-.5.4-.9.9-.9Z"></path>
          <path d="M21.3 11.1a.9.9 0 1 1 0 1.8h-1.35a.9.9 0 1 1 0-1.8h1.35Z"></path>
          <path d="M4.05 11.1a.9.9 0 1 1 0 1.8H2.7a.9.9 0 1 1 0-1.8h1.35Z"></path>
          <path d="M18.58 4.15a.9.9 0 0 1 1.27 1.27l-.95.95a.9.9 0 0 1-1.27-1.27l.95-.95Z"></path>
          <path d="M6.37 16.35a.9.9 0 0 1 0 1.27l-.95.95a.9.9 0 0 1-1.27-1.27l.95-.95a.9.9 0 0 1 1.27 0Z"></path>
          <path d="M19.85 18.58a.9.9 0 0 1-1.27 0l-.95-.95a.9.9 0 0 1 1.27-1.27l.95.95a.9.9 0 0 1 0 1.27Z"></path>
          <path d="M6.37 5.1a.9.9 0 0 1-1.27 1.27l-.95-.95a.9.9 0 0 1 1.27-1.27l.95.95Z"></path>
        </svg>
      </span>
      <span class="theme-icon moon" aria-hidden="true">
        <svg viewBox="0 0 24 24" focusable="false" role="img">
          <path d="M20.6 15.35c.36-.18.75.18.6.56A9.55 9.55 0 0 1 12.28 22C6.84 22 2.5 17.66 2.5 12.22c0-4.08 2.56-7.78 6.36-9.18.38-.14.73.25.55.61a7.6 7.6 0 0 0-.78 3.35 7.8 7.8 0 0 0 7.8 7.8c1.48 0 2.9-.42 4.17-1.2Z"></path>
        </svg>
      </span>
    </button>
  </nav>
</header>

<style>
  .site-nav-wrapper {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    padding: 0;
    border-bottom: 1px solid color-mix(in srgb, var(--border-color) 82%, transparent);
    background: color-mix(in srgb, var(--background-color) 88%, transparent);
    backdrop-filter: blur(10px) saturate(115%);
    transition: background-color 0.24s ease, border-color 0.24s ease, box-shadow 0.24s ease;
  }

  .site-nav-wrapper.is-scrolled {
    box-shadow: 0 8px 18px rgba(15, 15, 15, 0.05);
  }

  .site-nav {
    width: min(1440px, calc(100vw - 32px));
    margin-left: max(16px, calc((100vw - 1440px) / 2 + 8px));
    margin-right: auto;
    padding: 0.7rem 1.2rem;
    display: flex;
    gap: 0.85rem;
    align-items: center;
    transition: padding 0.24s ease;
  }

  .site-nav-wrapper.is-scrolled .site-nav {
    padding-top: 0.62rem;
    padding-bottom: 0.62rem;
  }

  .brand-lockup {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    min-width: 0;
    padding: 0.2rem 0.4rem 0.2rem 0;
    background: transparent;
    box-shadow: none;
  }

  .brand-lockup:hover,
  .brand-lockup:active {
    background: transparent;
    box-shadow: none;
    transform: none;
  }

  .brand-mark {
    width: 1.6rem;
    height: 1.6rem;
    flex: 0 0 auto;
    border-radius: 50%;
    object-fit: cover;
    border: 1px solid color-mix(in srgb, var(--border-color) 82%, transparent);
  }

  .brand-copy {
    display: flex;
    flex-direction: column;
    min-width: 0;
    line-height: 1.05;
  }

  .brand-title {
    color: var(--text-primary);
    font-size: 0.92rem;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .brand-subtitle {
    color: var(--text-secondary);
    font-size: 0.68rem;
    letter-spacing: 0.04em;
    text-transform: lowercase;
  }

  .nav-pill {
    display: flex;
    align-items: center;
    gap: 0.15rem;
    padding: 0;
    border-radius: 0;
    background: transparent;
    border: none;
    margin-left: 1.25rem;
  }

  .nav-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2rem;
    padding: 0.45rem 0.8rem;
    border-radius: 0.45rem;
    background: transparent;
    color: var(--text-secondary);
    font-size: 0.88rem;
    letter-spacing: 0.01em;
    box-shadow: none;
    transition: color 0.2s ease, background-color 0.2s ease, transform 0.18s ease;
  }

  .nav-link span {
    position: relative;
    z-index: 1;
  }

  .nav-link::after {
    content: '';
    position: absolute;
    inset: auto 0.75rem 0.28rem;
    height: 2px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--text-primary) 75%, transparent);
    opacity: 0;
    transform: scaleX(0.55);
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  .nav-link:hover {
    background: color-mix(in srgb, var(--nice-div-color) 55%, transparent);
    color: var(--text-primary);
    box-shadow: none;
    transform: none;
  }

  .nav-link:hover::after,
  .nav-link.active::after {
    opacity: 1;
    transform: scaleX(1);
  }

  .nav-link.active {
    color: var(--text-primary);
    background: color-mix(in srgb, var(--nice-div-color) 42%, transparent);
    box-shadow: none;
  }

  .theme-toggle {
    width: 1.65rem;
    height: 2rem;
    border-radius: 0;
    border: none;
    background: transparent;
    color: var(--text-secondary);
    font-size: 1rem;
    line-height: 1;
    padding: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-left: auto;
    box-shadow: none;
  }

  .theme-toggle:hover {
    background: transparent;
    color: var(--text-primary);
    box-shadow: none;
  }

  .theme-toggle:active {
    transform: none;
    box-shadow: none;
  }

  .theme-icon {
    width: 1rem;
    height: 1rem;
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  .theme-icon svg {
    width: 100%;
    height: 100%;
    display: block;
    fill: currentColor;
  }

  .theme-icon.sun {
    display: none;
  }

  .theme-icon.moon {
    display: block;
  }

  html[data-theme="dark"] .theme-icon.sun {
    display: block;
  }

  html[data-theme="dark"] .theme-icon.moon {
    display: none;
  }

  @media (max-width: 860px) {
    .site-nav {
      width: auto;
      margin-left: 0;
      margin-right: 0;
      padding: 0.7rem 0.9rem;
      flex-wrap: wrap;
    }

    .brand-lockup {
      flex: 1 1 auto;
    }

    .nav-pill {
      order: 3;
      width: 100%;
      justify-content: space-between;
      margin-left: 0;
      padding-top: 0.2rem;
      flex-wrap: wrap;
    }

    .nav-link {
      flex: 1 1 calc(20% - 0.2rem);
      min-width: 0;
      padding-inline: 0.7rem;
    }
  }

  @media (max-width: 560px) {
    .site-nav-wrapper {
      top: 0;
    }

    .site-nav {
      gap: 0.6rem;
      padding-inline: 0.8rem;
    }

    .brand-subtitle {
      display: none;
    }

    .nav-pill {
      flex-wrap: wrap;
    }

    .nav-link {
      flex: 1 1 calc(50% - 0.2rem);
    }

    .theme-toggle {
      margin-left: auto;
    }
  }
</style>

<script>
  function initTheme() {
    const html = document.documentElement;
    const storedTheme = localStorage.getItem('theme');
    const prefersDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;

    if (storedTheme === 'dark' || (storedTheme === null && prefersDark)) {
      html.setAttribute('data-theme', 'dark');
    } else if (storedTheme === 'light') {
      html.setAttribute('data-theme', 'light');
    }
  }

  function setupThemeToggle() {
    const toggle = document.querySelector('.theme-toggle');
    if (!toggle) return;

    toggle.addEventListener('click', () => {
      const html = document.documentElement;
      const currentTheme = html.getAttribute('data-theme');
      const newTheme = currentTheme === 'dark' ? 'light' : 'dark';
      
      html.setAttribute('data-theme', newTheme);
      localStorage.setItem('theme', newTheme);
      document.dispatchEvent(new CustomEvent('theme-change', { detail: { theme: newTheme } }));
    });
  }

  function applyMobileNavBackground() {
    const wrapper = document.querySelector('.site-nav-wrapper');
    if (!wrapper) return;

    wrapper.classList.toggle('is-scrolled', window.scrollY > 8);
  }

  document.addEventListener('DOMContentLoaded', () => {
    initTheme();
    setupThemeToggle();

    const toggle = document.querySelector('.theme-toggle');
    if (toggle) {
      toggle.addEventListener('click', () => {
        setTimeout(applyMobileNavBackground, 0);
      });
    }

    applyMobileNavBackground();
    window.addEventListener('scroll', applyMobileNavBackground, { passive: true });
    window.addEventListener('resize', applyMobileNavBackground);
  });
</script>
