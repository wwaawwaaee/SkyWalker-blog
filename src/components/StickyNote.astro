---
interface Props {
  text?: string;
}

const { text = "click here!" } = Astro.props;
---

<button id="click-note" class="click-note" aria-label="Click to discover the interactive background">
  {text}
</button>

<style>
  .click-note {
    position: fixed;
    top: 42%;
    right: 13%;
    z-index: 3;
    background: #fffdf5;
    color: #333;
    border: 1px solid rgba(0, 0, 0, 0.08);
    border-radius: 6px;
    box-shadow: 0 8px 18px rgba(0, 0, 0, 0.15);
    padding: 10px 14px;
    font-family: 'Shadows Into Light', cursive;
    font-size: 20px;
    transform: rotate(-4deg);
    cursor: pointer;
    user-select: none;
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  .click-note::before {
    content: "";
    position: absolute;
    left: -22px;
    top: -22px;
    width: calc(100% + 44px);
    height: calc(100% + 34px);
    border: none;
    pointer-events: none;
    transform: rotate(-6deg);
    transition: opacity 0.2s ease;
    background-repeat: no-repeat;
    background-size: 100% 100%;
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 200 160'><defs><filter id='rough'><feTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='2' seed='3' result='noise'/><feDisplacementMap in='SourceGraphic' in2='noise' scale='2'/></filter></defs><ellipse cx='100' cy='80' rx='92' ry='66' fill='none' stroke='%23DC143C' stroke-width='2' stroke-linecap='round' opacity='0.85' filter='url(%23rough)' transform='rotate(-6 100 80)'/></svg>");
  }

  .click-note::after {
    content: "";
    position: absolute;
    left: -18px;
    top: -16px;
    width: calc(100% + 36px);
    height: calc(100% + 26px);
    border: none;
    pointer-events: none;
    transform: rotate(-2deg);
    transition: opacity 0.2s ease;
    background-repeat: no-repeat;
    background-size: 100% 100%;
    opacity: 0.6;
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 200 160'><defs><filter id='rough2'><feTurbulence type='fractalNoise' baseFrequency='0.7' numOctaves='2' seed='7' result='noise'/><feDisplacementMap in='SourceGraphic' in2='noise' scale='1.8'/></filter></defs><ellipse cx='100' cy='80' rx='94' ry='68' fill='none' stroke='%23DC143C' stroke-width='3' stroke-linecap='round' stroke-dasharray='6 3 2 4' filter='url(%23rough2)'/></svg>");
  }

  .click-note:focus {
    outline: none;
  }

  .click-note.hidden {
    opacity: 0;
    transform: rotate(-4deg) scale(0.98);
    pointer-events: none;
  }

  .click-note.hidden::before,
  .click-note.hidden::after {
    opacity: 0;
  }

  html[data-theme="dark"] .click-note {
    background: #1a1a1a;
    color: #e6e6e6;
    border-color: #3b3d3e;
    box-shadow: 0 8px 18px rgba(0, 0, 0, 0.4);
  }

  @media (max-width: 768px) {
    .click-note {
      display: none;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const note = document.getElementById('click-note');
    if (!note) return;

    note.addEventListener('click', (e) => {
      note.classList.add('hidden');

      const canvas = document.querySelector('#particles-js canvas');
      if (canvas) {
        const rect = note.getBoundingClientRect();
        const cx = (e as MouseEvent).clientX || (rect.left + rect.width / 2);
        const cy = (e as MouseEvent).clientY || (rect.top + rect.height / 2);

        for (let i = 0; i < 70; i++) {
          setTimeout(() => {
            const evt = new MouseEvent('click', {
              view: window,
              bubbles: true,
              cancelable: true,
              clientX: cx,
              clientY: cy
            });
            canvas.dispatchEvent(evt);
          }, i * 60);
        }
      }

      setTimeout(() => {
        if (note.parentNode) note.parentNode.removeChild(note);
      }, 400);

      if (window.innerWidth > 768 && document.documentElement.getAttribute('data-theme') !== 'dark') {
        setTimeout(() => {
          const existing = document.getElementById('mode-note');
          if (!existing) {
            const modeNote = document.createElement('div');
            modeNote.id = 'mode-note';
            modeNote.className = 'mode-note';
            modeNote.textContent = 'dark mode looks cooler!';
            modeNote.style.cssText = `
              position: fixed;
              top: 86px;
              right: 7.5rem;
              z-index: 3;
              background: #fffdf5;
              color: #333;
              border: 1px solid rgba(0,0,0,0.08);
              border-radius: 6px;
              box-shadow: 0 8px 18px rgba(0,0,0,0.15);
              padding: 8px 12px;
              font-family: 'Shadows Into Light', cursive;
              font-size: 18px;
              transform: rotate(-2deg);
              cursor: pointer;
              user-select: none;
              transition: opacity 0.2s ease, transform 0.2s ease;
            `;

            modeNote.addEventListener('click', () => {
              modeNote.style.opacity = '0';
              setTimeout(() => { if (modeNote.parentNode) modeNote.parentNode.removeChild(modeNote); }, 240);
            });

            document.body.appendChild(modeNote);

            setTimeout(() => {
              if (modeNote.parentNode) {
                modeNote.style.opacity = '0';
                setTimeout(() => { if (modeNote.parentNode) modeNote.parentNode.removeChild(modeNote); }, 260);
              }
            }, 3000);
          }
        }, 4000);
      }
    });
  });
</script>
