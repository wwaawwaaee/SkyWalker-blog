---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const aboutPosts = await getCollection('about');
const about = aboutPosts[0];
const { Content } = await about.render();
---

<BaseLayout title={`关于 - ${SITE_TITLE}`} description={SITE_DESCRIPTION} currentPath="/about">
  <div class="container page-shell narrow">
    <section class="content-card">
      <span class="section-kicker">关于</span>
      <Content />
      <p class="back-link"><a href="/">← 返回首页</a></p>
    </section>
  </div>
</BaseLayout>

<style>
  .back-link {
    margin-top: 2em;
  }
</style>
