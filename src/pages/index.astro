---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_AUTHOR, SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const latestPosts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const postCount = (await getCollection('blog', ({ data }) => !data.draft)).length;
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
  <div class="container home-layout">
    <aside class="home-sidebar">
      <section class="profile-card sidebar-panel interactive-surface">
        <span class="section-kicker">简介</span>
        <div class="profile-mark">S</div>
        <h1>{SITE_AUTHOR}</h1>
        <p class="profile-lede">{SITE_DESCRIPTION}</p>
        <p class="profile-note">这里用来放随笔、构建记录，以及那些不想被聊天记录淹没的想法。</p>
        <div class="profile-actions">
          <a href="/blog" class="primary-link">进入文章页</a>
          <a href="/feed.xml">订阅 RSS</a>
        </div>
      </section>

      <section class="sidebar-panel intro-panel interactive-surface">
        <span class="section-kicker">欢迎</span>
        <h2>{SITE_TITLE}</h2>
        <p class="intro-copy">这个首页强调可持续写作：文章使用 Markdown 管理，页面静态生成，交互保持克制。</p>
        <p class="intro-copy">现在主体区域只保留文章流，左侧则作为更轻的个人信息栏。</p>
      </section>

      <section class="sidebar-panel stats-card interactive-surface">
        <span class="section-kicker">概览</span>
        <div class="stat-grid">
          <div>
            <strong>{postCount}</strong>
            <span>已发布文章</span>
          </div>
          <div>
            <strong>Astro</strong>
            <span>静态工作流</span>
          </div>
          <div>
            <strong>RSS</strong>
            <span>内置订阅</span>
          </div>
          <div>
            <strong>深色</strong>
            <span>主题可切换</span>
          </div>
        </div>
      </section>

      <section class="sidebar-panel quick-links interactive-surface">
        <span class="section-kicker">快捷入口</span>
        <a href="/about">关于本站</a>
        <a href="/contact">联系</a>
        <a href="/sitemap-index.xml">站点地图</a>
      </section>
    </aside>

    <main class="home-main page-shell">
      <section class="content-card latest-posts-section">
        <div class="section-header">
          <div>
            <span class="section-kicker">最近写作</span>
            <h2>最新文章</h2>
          </div>
          <a href="/blog">查看全部</a>
        </div>

        <div class="post-list">
          {latestPosts.map((post) => (
            <article class="post-row interactive-surface">
              <div class="post-row-meta">
                <span>{post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}</span>
              </div>
              <div class="post-row-body">
                <h3><a href={`/blog/${post.slug}`}>{post.data.title}</a></h3>
                <p>{post.data.description}</p>
              </div>
            </article>
          ))}
        </div>
      </section>
    </main>
  </div>
</BaseLayout>

<style>
  .home-layout {
    display: grid;
    grid-template-columns: 210px minmax(0, 1fr);
    gap: 1.5rem;
    align-items: start;
  }

  .home-sidebar {
    position: sticky;
    top: 5.5rem;
    display: grid;
    gap: 0.85rem;
    margin-left: -1rem;
  }

  .home-main {
    min-width: 0;
  }

  .hero-stage {
    display: grid;
    grid-template-columns: minmax(260px, 0.8fr) minmax(420px, 1.35fr);
    gap: 1rem;
    align-items: stretch;
  }

  .sidebar-panel {
    border-left: 2px solid color-mix(in srgb, var(--border-color) 88%, transparent);
    padding: 0.1rem 0 0.1rem 1rem;
    background: transparent;
    border-radius: 0;
    box-shadow: none;
  }

  .sidebar-panel:hover {
    border-left-color: color-mix(in srgb, var(--text-secondary) 30%, var(--border-color) 70%);
  }

  .profile-card h1,
  .intro-panel h2,
  .latest-posts-section h2 {
    margin-top: 0;
    margin-bottom: 0.4rem;
  }

  .profile-mark {
    width: 3rem;
    height: 3rem;
    display: grid;
    place-items: center;
    margin-bottom: 0.8rem;
    border-radius: 0.9rem;
    background: linear-gradient(145deg, color-mix(in srgb, var(--text-primary) 92%, transparent), color-mix(in srgb, var(--text-secondary) 88%, transparent));
    color: var(--background-color);
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: -0.05em;
  }

  .profile-lede,
  .profile-note,
  .intro-copy,
  .post-row p {
    color: var(--text-secondary);
  }

  .intro-panel h2 {
    font-size: 1.22rem;
  }

  .profile-actions {
    display: flex;
    gap: 0.8rem;
    flex-wrap: wrap;
    margin-top: 0.9rem;
  }

  .primary-link {
    background: var(--text-primary);
    color: var(--background-color);
  }

  .primary-link:hover {
    background: var(--text-secondary);
  }

  .stats-card strong {
    display: block;
    color: var(--text-primary);
    font-size: 1rem;
    margin-bottom: 0.15rem;
  }

  .stats-card span {
    color: var(--text-secondary);
    font-size: 0.9rem;
  }

  .stat-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.8rem 0.9rem;
  }

  .quick-links {
    display: grid;
    gap: 0.55rem;
  }

  .quick-links a {
    width: fit-content;
  }

  .section-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.8rem;
  }

  .post-list {
    display: grid;
    gap: 1rem;
  }

  .post-row {
    display: grid;
    grid-template-columns: 140px minmax(0, 1fr);
    gap: 1rem;
    border: 1px solid var(--border-color);
    border-radius: 18px;
    padding: 1rem 1.05rem;
    background: color-mix(in srgb, var(--background-color) 96%, var(--nice-div-color) 4%);
  }

  .post-row-meta {
    color: var(--text-secondary);
    font-size: 0.84rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .post-row-body h3 {
    margin-top: 0;
    margin-bottom: 0.35rem;
  }

  .post-row-body p,
  .post-row-body h3 {
    margin-bottom: 0;
  }

  @media (max-width: 960px) {
    .home-layout {
      grid-template-columns: 1fr;
    }

    .home-sidebar {
      position: static;
      margin-left: 0;
    }

    .sidebar-panel {
      border-left-width: 0;
      padding-left: 0;
    }
  }

  @media (max-width: 768px) {
    .post-row,
    .stat-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 560px) {
    .profile-actions,
    .section-header {
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>
