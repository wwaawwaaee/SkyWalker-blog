    margin-bottom: 0.18rem;
    font-size: 1rem;
    line-height: 1.28;
  }

  .homepage-publication-item h3 a {
    position: relative;
    display: inline;
    padding: 0;
    background: none;
    border-radius: 0;
    box-shadow: none;
    color: var(--text-primary);
    text-decoration: none;
    transform: none;
  }

  .homepage-publication-item h3 a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -0.08rem;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 0.22s ease;
  }

  .homepage-publication-item h3 a:hover,
  .homepage-publication-item h3 a:active {
    background: none;
    box-shadow: none;
    color: var(--text-primary);
    transform: none;
  }

  .homepage-publication-item h3 a:hover::after,
  .homepage-publication-item h3 a:active::after {
