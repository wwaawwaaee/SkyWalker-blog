---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_AUTHOR, SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const SELF_AUTHOR = 'Zheyu Zhang';

function stripMarkdown(source: string) {
  return source
    .replace(/^---[\s\S]*?---/, '')
    .replace(/```[\s\S]*?```/g, ' ')
    .replace(/`([^`]+)`/g, '$1')
    .replace(/!\[[^\]]*\]\([^)]*\)/g, ' ')
    .replace(/\[[^\]]+\]\([^)]*\)/g, '$1')
    .replace(/^#{1,6}\s+/gm, '')
    .replace(/^[>*+-]\s+/gm, '')
    .replace(/^\d+\.\s+/gm, '')
    .replace(/[>*_~#-]/g, ' ')
    .replace(/\s+/g, ' ')
    .trim();
}

function truncateText(source: string, length: number) {
  const chars = Array.from(source);
  return chars.length > length ? `${chars.slice(0, length).join('')}...` : source;
}

const latestPosts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 4);

const publicationEntries = (await getCollection('publication', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const publicationCount = publicationEntries.length;
const latestPublications = publicationEntries.slice(0, 4);
const homepagePublications = latestPublications.map((item) => {
  const metadata = [
    item.data.pubDate.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' }),
    item.data.venue,
    item.data.venueDetail,
  ].filter(Boolean);

  return {
    title: item.data.title,
    authors: item.data.authors,
    description: item.data.description,
    blogLink: item.data.blogLink,
    officialLink: item.data.officialLink,
    titleHref: item.data.officialLink ?? item.data.blogLink,
    metadata: metadata.join(' · '),
  };
});
const previewPosts = latestPosts.map((post, index) => ({
  index,
  slug: post.slug,
  title: post.data.title,
  description: post.data.description,
  dateLabel: post.data.pubDate.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' }),
  excerpt: truncateText(stripMarkdown(post.body), 50),
  cover: post.data.cover ?? '',
}));
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
