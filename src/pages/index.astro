  }

  .publication-section {
    position: relative;
    padding-bottom: 1.1rem;
    background: color-mix(in srgb, var(--background-color) 98%, var(--nice-div-color) 2%);
    border-style: solid;
  }

  .publication-header {
    margin-bottom: 0.55rem;
  }

  .publication-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--text-secondary);
    font-size: 0.74rem;
