    <aside class="home-sidebar">
      <section class="profile-card sidebar-panel researcher-card">
        <span class="section-kicker">Profile</span>
        <div class="profile-header">
          <img src="/img/logo.png" alt="Zheyu Zhang avatar" class="profile-mark" />
          <div class="profile-copy">
            <h1>Zheyu Zhang</h1>
            <p class="profile-affiliation">Beijing Institute of Technology</p>
          </div>
        </div>

        <nav class="profile-links" aria-label="Profile links">
          <a href="https://sky.axono.org">
            <svg class="profile-link-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <circle cx="12" cy="12" r="9"></circle>
              <path d="M3 12h18"></path>
              <path d="M12 3c2.2 2.45 3.3 5.45 3.3 9s-1.1 6.55-3.3 9c-2.2-2.45-3.3-5.45-3.3-9S9.8 5.45 12 3Z"></path>
            </svg>
            <span>Website</span>
          </a>
          <a href="https://github.com/wwaawwaaee">
            <svg class="profile-link-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="M8 18.5c-2.25-.75-3.9-2.75-3.9-5.35 0-1.35.48-2.62 1.32-3.62-.15-.8-.02-1.78.4-2.98 1.08.05 2.05.48 2.85 1.05A7.9 7.9 0 0 1 12 6.9c1.18 0 2.3.25 3.33.7.8-.57 1.77-1 2.85-1.05.42 1.2.55 2.18.4 2.98.84 1 1.32 2.27 1.32 3.62 0 2.6-1.65 4.6-3.9 5.35"></path>
              <path d="M9.1 17.7c.45.35.68.82.68 1.42v1.48"></path>
              <path d="M14.22 20.6v-1.48c0-.6.23-1.07.68-1.42"></path>
            </svg>
            <span>GitHub</span>
          </a>
          <a href="https://scholar.google.com/scholar?q=Zheyu+Zhang+Beijing+Institute+of+Technology">
            <svg class="profile-link-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="M3 8.8 12 4l9 4.8-9 4.8L3 8.8Z"></path>
              <path d="M6.8 11v4.1c1.4 1.15 3.15 1.72 5.2 1.72s3.8-.57 5.2-1.72V11"></path>
              <path d="M20 9.4v5.25"></path>
            </svg>
            <span>Scholar</span>
          </a>
          <a href="mailto:zheyu070821@gmail.com">
            <svg class="profile-link-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <rect x="3.5" y="5.5" width="17" height="13" rx="1.8"></rect>
              <path d="m4.2 7 7.8 6.1L19.8 7"></path>
            </svg>
            <span>Email</span>
          </a>
          <a href="mailto:zheyu.zhang@bit.edu.cn">
            <svg class="profile-link-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="M4 20h16"></path>
              <path d="M5.5 9.2 12 4l6.5 5.2"></path>
              <path d="M7 9.5h10V20H7V9.5Z"></path>
              <path d="M10 20v-5h4v5"></path>
              <path d="M9 12h1.4"></path>
              <path d="M13.6 12H15"></path>
            </svg>
            <span>BIT Email</span>
          </a>
        </nav>
      </section>
    </aside>

    <main class="home-main page-shell">
      <section class="home-quote-block">
        <blockquote class="home-quote">
          One day you'll leave this world behind<br />
          So live a life you will remember
        </blockquote>
      </section>

      <section class="content-card publication-section">
        <div class="section-header publication-header">
          <div>
            <span class="section-kicker">Publication</span>
            <h2>发表与出版</h2>
          </div>
          <span class="publication-badge">{publicationCount === 0 ? '0 item' : `${publicationCount} item${publicationCount > 1 ? 's' : ''}`}</span>
        </div>

        {publicationCount === 0 ? (
          <div class="publication-empty">
            <p>现在还没有上传发表内容；可以先前往 <a href="/publication">publication 页面</a>查看归档入口。</p>
          </div>
        ) : (
          <>
            <div class="homepage-publication-list" role="list">
              {homepagePublications.map((publication) => (
                <article class="homepage-publication-item" role="listitem">
                  <h3>
                    {publication.titleHref ? <a href={publication.titleHref}>{publication.title}</a> : publication.title}
                  </h3>
                  {publication.authors.length > 0 && (
                    <p class="homepage-publication-authors">
                      {publication.authors.map((author, authorIndex) => (
                        <>
                          <span class:list={['homepage-publication-author', { 'is-self': author === SELF_AUTHOR }]}>{author}</span>
                          {authorIndex < publication.authors.length - 1 && <span class="homepage-publication-author-separator" aria-hidden="true"> · </span>}
                        </>
                      ))}
                    </p>
                  )}
                  {publication.metadata && <p class="homepage-publication-meta">{publication.metadata}</p>}
                  {publication.description && <p class="homepage-publication-description">{publication.description}</p>}
                  <div class="homepage-publication-links">
                    {publication.blogLink && <a href={publication.blogLink}>博客解读</a>}
                    {publication.officialLink && <a href={publication.officialLink}>官方链接</a>}
                    {!publication.blogLink && !publication.officialLink && <a href="/publication">详情</a>}
                  </div>
                </article>
              ))}
            </div>
            <p class="homepage-publication-footer"><a href="/publication">查看全部发表</a></p>
          </>
        )}
      </section>

      <section class="content-card latest-posts-section" data-preview-posts={JSON.stringify(previewPosts)}>
        <div class="section-header">
          <div>
            <span class="section-kicker">Blog</span>
            <h2>最近写作</h2>
          </div>
          <a href="/blog">查看全部</a>
        </div>

        <div class="writing-stage">
          <div class="post-list" role="list">
            {previewPosts.map((post) => (
              <article class:list={['post-row', 'interactive-surface', { active: post.index === 0 }]} data-preview-index={post.index}>
                <div class="post-row-meta">
                  <span>{post.dateLabel}</span>
                </div>
                <div class="post-row-body">
                  <h3><a href={`/blog/${post.slug}`}>{post.title}</a></h3>
                  <p>{post.description}</p>
                </div>
              </article>
            ))}
          </div>

          <div class="preview-stage-wrap">
            <div class="preview-ghost preview-ghost-top" aria-hidden="true"></div>

            <a class="preview-stage interactive-surface" href={`/blog/${previewPosts[0].slug}`}>
              <div class="preview-cover">
                <img src={previewPosts[0].cover} alt="" class="preview-image" />
              </div>
              <div class="preview-content">
                <span class="section-kicker">封面预览</span>
                <p class="preview-date">{previewPosts[0].dateLabel}</p>
                <h3 class="preview-title">{previewPosts[0].title}</h3>
                <p class="preview-excerpt">{previewPosts[0].excerpt}</p>
              </div>
            </a>

            <div class="preview-ghost preview-ghost-bottom" aria-hidden="true"></div>
          </div>
        </div>
      </section>
    </main>
  </div>
</BaseLayout>

<script is:inline>
  document.addEventListener('DOMContentLoaded', function () {
    var section = document.querySelector('.latest-posts-section');
    if (!section) return;

    var rawPosts = section.getAttribute('data-preview-posts');
    if (!rawPosts) return;

    var posts = JSON.parse(rawPosts);
    if (!posts.length) return;

    var rows = Array.from(section.querySelectorAll('.post-row'));
    var stage = section.querySelector('.preview-stage');
    var image = section.querySelector('.preview-image');
    var date = section.querySelector('.preview-date');
    var title = section.querySelector('.preview-title');
    var excerpt = section.querySelector('.preview-excerpt');
    var topGhost = section.querySelector('.preview-ghost-top');
    var bottomGhost = section.querySelector('.preview-ghost-bottom');
    var activeIndex = 0;

    function setGhost(card, post) {
      if (!card || !post) return;
      card.style.backgroundImage = 'url("' + post.cover + '")';
    }

    function render(index) {
      var post = posts[index];
      if (!post || !stage || !image || !date || !title || !excerpt) return;

      activeIndex = index;
      stage.classList.remove('preview-animating');
      void stage.offsetWidth;
      stage.classList.add('preview-animating');
      stage.setAttribute('href', '/blog/' + post.slug);
      image.setAttribute('src', post.cover);
      date.textContent = post.dateLabel;
      title.textContent = post.title;
      excerpt.textContent = post.excerpt;

      rows.forEach(function (row, rowIndex) {
        row.classList.toggle('active', rowIndex === index);
      });

      var prev = posts[(index - 1 + posts.length) % posts.length];
      var next = posts[(index + 1) % posts.length];
      setGhost(topGhost, prev);
      setGhost(bottomGhost, next);
    }

    rows.forEach(function (row) {
      var index = Number(row.getAttribute('data-preview-index'));
      row.addEventListener('mouseenter', function () { render(index); });
      row.addEventListener('focusin', function () { render(index); });
    });

    render(activeIndex);
  });
</script>

<style>
  .home-layout {
    display: grid;
    grid-template-columns: 210px minmax(0, 1fr);
    gap: 1.5rem;
    align-items: start;
  }

  .home-sidebar {
    position: sticky;
    top: 5.5rem;
    display: grid;
    gap: 0.2rem;
    margin-left: -0.7rem;
    align-self: start;
    max-height: 38vh;
  }

  .home-main {
    min-width: 0;
  }

  .home-main > * {
    min-width: 0;
  }

  .home-quote-block {
    padding: 0.2rem 0 1rem;
    margin-bottom: 0.35rem;
  }

  .home-quote {
    margin: 0;
    color: var(--text-primary);
    font-size: clamp(1.1rem, 1.7vw, 1.32rem);
    line-height: 1.5;
    letter-spacing: -0.02em;
    border-left: 2px solid color-mix(in srgb, var(--border-color) 72%, transparent);
    padding-left: 0.9rem;
    font-style: normal;
  }

  .hero-stage {
    display: grid;
    grid-template-columns: minmax(260px, 0.8fr) minmax(420px, 1.35fr);
