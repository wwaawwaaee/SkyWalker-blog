---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_AUTHOR, SITE_DESCRIPTION, SITE_TITLE } from '../consts';

function stripMarkdown(source: string) {
  return source
    .replace(/^---[\s\S]*?---/, '')
    .replace(/```[\s\S]*?```/g, ' ')
    .replace(/`([^`]+)`/g, '$1')
    .replace(/!\[[^\]]*\]\([^)]*\)/g, ' ')
    .replace(/\[[^\]]+\]\([^)]*\)/g, '$1')
    .replace(/^#{1,6}\s+/gm, '')
    .replace(/^[>*+-]\s+/gm, '')
    .replace(/^\d+\.\s+/gm, '')
    .replace(/[>*_~#-]/g, ' ')
    .replace(/\s+/g, ' ')
    .trim();
}

function truncateText(source: string, length: number) {
  const chars = Array.from(source);
  return chars.length > length ? `${chars.slice(0, length).join('')}...` : source;
}

const latestPosts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 4);

const publicationEntries = (await getCollection('publication', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const publicationCount = publicationEntries.length;
const latestPublication = publicationEntries[0];
const previewPosts = latestPosts.map((post, index) => ({
  index,
  slug: post.slug,
  title: post.data.title,
  description: post.data.description,
  dateLabel: post.data.pubDate.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' }),
  excerpt: truncateText(stripMarkdown(post.body), 50),
  cover: post.data.cover ?? '',
}));
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
  <div class="container home-layout">
    <aside class="home-sidebar">
      <section class="profile-card sidebar-panel researcher-card">
        <span class="section-kicker">Profile</span>
        <img src="/img/logo.png" alt="SkyWalker 头像" class="profile-mark" />
        <h1>Zheyu Zhang</h1>
        <p class="profile-lede">SkyWalker · 北京理工大学</p>

        <div class="identity-list">
          <div>
            <span class="identity-label">Website</span>
            <a href="https://sky.axono.org">sky.axono.org</a>
          </div>
          <div>
            <span class="identity-label">GitHub</span>
            <a href="https://github.com/wwaawwaaee">github.com/wwaawwaaee</a>
          </div>
          <div>
            <span class="identity-label">Email</span>
            <a href="mailto:zheyu070821@gmail.com">zheyu070821@gmail.com</a>
          </div>
          <div>
            <span class="identity-label">Email (BIT)</span>
            <a href="mailto:zheyu.zhang@bit.edu.cn">zheyu.zhang@bit.edu.cn</a>
          </div>
        </div>
      </section>
    </aside>

    <main class="home-main page-shell">
      <section class="home-quote-block">
        <blockquote class="home-quote">
          One day you'll leave this world behind<br />
          So live a life you will remember
        </blockquote>
      </section>

      <section class="content-card publication-section">
        <div class="section-header publication-header">
          <div>
            <span class="section-kicker">Publication</span>
            <h2>发表与出版</h2>
          </div>
          <span class="publication-badge">{publicationCount === 0 ? '0 item' : `${publicationCount} item${publicationCount > 1 ? 's' : ''}`}</span>
        </div>

        <div class="publication-stage">
          <div class="publication-copy">
            <p class="publication-lede">这一栏会用来整理以后公开发表的论文、刊物文章、会议摘要或更正式的长篇写作。</p>
            {publicationCount === 0 ? (
              <>
                <p>现在还没有上传内容，但这里会与 blog 保持不同的气质：更稳定、更归档化，也更适合承载长期可引用的作品。</p>
                <p class="publication-hint">以后只需要把内容放进 <code>src/content/publication</code>，这里就能自然长出来。点击可进入 publication 页面。</p>
              </>
            ) : (
              <div class="publication-paper">
                <div class="publication-paper-cover">
                  <img src={latestPublication.data.cover} alt="" />
                </div>
                <div class="publication-paper-body">
                  <p class="publication-paper-meta">
                    <span>{latestPublication.data.pubDate.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' })}</span>
                    {latestPublication.data.venue && <span>{latestPublication.data.venue}</span>}
                  </p>
                  <h3>{latestPublication.data.title}</h3>
                  {latestPublication.data.authors.length > 0 && <p class="publication-authors">{latestPublication.data.authors.join(' · ')}</p>}
                  {latestPublication.data.affiliation && <p class="publication-affiliation">{latestPublication.data.affiliation}</p>}
                  {latestPublication.data.venueDetail && <p class="publication-venue">{latestPublication.data.venueDetail}</p>}
                  {latestPublication.data.abstract && <p class="publication-abstract">{latestPublication.data.abstract}</p>}
                  <div class="publication-actions">
                    {latestPublication.data.blogLink && <a href={latestPublication.data.blogLink}>博客解读</a>}
                    {latestPublication.data.officialLink && <a href={latestPublication.data.officialLink}>官方链接</a>}
                    <a href="/publication">查看全部发表</a>
                  </div>
                </div>
              </div>
            )}
          </div>

          <div class="publication-placeholder" aria-hidden="true">
            <div class="publication-stack publication-main"></div>
            <div class="publication-stack publication-back publication-back-one"></div>
            <div class="publication-stack publication-back publication-back-two"></div>
          </div>
        </div>
      </section>

      <section class="content-card latest-posts-section" data-preview-posts={JSON.stringify(previewPosts)}>
        <div class="section-header">
          <div>
            <span class="section-kicker">Blog</span>
            <h2>最近写作</h2>
          </div>
          <a href="/blog">查看全部</a>
        </div>

        <div class="writing-stage">
          <div class="post-list" role="list">
            {previewPosts.map((post) => (
              <article class:list={['post-row', 'interactive-surface', { active: post.index === 0 }]} data-preview-index={post.index}>
                <div class="post-row-meta">
                  <span>{post.dateLabel}</span>
                </div>
                <div class="post-row-body">
                  <h3><a href={`/blog/${post.slug}`}>{post.title}</a></h3>
                  <p>{post.description}</p>
                </div>
              </article>
            ))}
          </div>

          <div class="preview-stage-wrap">
            <div class="preview-ghost preview-ghost-top" aria-hidden="true"></div>

            <a class="preview-stage interactive-surface" href={`/blog/${previewPosts[0].slug}`}>
              <div class="preview-cover">
                <img src={previewPosts[0].cover} alt="" class="preview-image" />
              </div>
              <div class="preview-content">
                <span class="section-kicker">封面预览</span>
                <p class="preview-date">{previewPosts[0].dateLabel}</p>
                <h3 class="preview-title">{previewPosts[0].title}</h3>
                <p class="preview-excerpt">{previewPosts[0].excerpt}</p>
              </div>
            </a>

            <div class="preview-ghost preview-ghost-bottom" aria-hidden="true"></div>
          </div>
        </div>
      </section>
    </main>
  </div>
</BaseLayout>

<script is:inline>
  document.addEventListener('DOMContentLoaded', function () {
    var section = document.querySelector('.latest-posts-section');
    if (!section) return;

    var rawPosts = section.getAttribute('data-preview-posts');
    if (!rawPosts) return;

    var posts = JSON.parse(rawPosts);
    if (!posts.length) return;

    var rows = Array.from(section.querySelectorAll('.post-row'));
    var stage = section.querySelector('.preview-stage');
    var image = section.querySelector('.preview-image');
    var date = section.querySelector('.preview-date');
    var title = section.querySelector('.preview-title');
    var excerpt = section.querySelector('.preview-excerpt');
    var topGhost = section.querySelector('.preview-ghost-top');
    var bottomGhost = section.querySelector('.preview-ghost-bottom');
    var activeIndex = 0;

    function setGhost(card, post) {
      if (!card || !post) return;
      card.style.backgroundImage = 'url("' + post.cover + '")';
    }

    function render(index) {
      var post = posts[index];
      if (!post || !stage || !image || !date || !title || !excerpt) return;

      activeIndex = index;
      stage.classList.remove('preview-animating');
      void stage.offsetWidth;
      stage.classList.add('preview-animating');
      stage.setAttribute('href', '/blog/' + post.slug);
      image.setAttribute('src', post.cover);
      date.textContent = post.dateLabel;
      title.textContent = post.title;
      excerpt.textContent = post.excerpt;

      rows.forEach(function (row, rowIndex) {
        row.classList.toggle('active', rowIndex === index);
      });

      var prev = posts[(index - 1 + posts.length) % posts.length];
      var next = posts[(index + 1) % posts.length];
      setGhost(topGhost, prev);
      setGhost(bottomGhost, next);
    }

    rows.forEach(function (row) {
      var index = Number(row.getAttribute('data-preview-index'));
      row.addEventListener('mouseenter', function () { render(index); });
      row.addEventListener('focusin', function () { render(index); });
    });

    render(activeIndex);
  });
</script>

<style>
  .home-layout {
    display: grid;
    grid-template-columns: 210px minmax(0, 1fr);
    gap: 1.5rem;
    align-items: start;
  }

  .home-sidebar {
    position: sticky;
    top: 5.5rem;
    display: grid;
    gap: 0.2rem;
    margin-left: -0.7rem;
    align-self: start;
    max-height: 38vh;
  }

  .home-main {
    min-width: 0;
  }

  .home-quote-block {
    padding: 0.2rem 0 1rem;
    margin-bottom: 0.35rem;
  }

  .home-quote {
    margin: 0;
    color: var(--text-primary);
    font-size: clamp(1.1rem, 1.7vw, 1.32rem);
    line-height: 1.5;
    letter-spacing: -0.02em;
    border-left: 2px solid color-mix(in srgb, var(--border-color) 72%, transparent);
    padding-left: 0.9rem;
    font-style: normal;
  }

  .hero-stage {
    display: grid;
    grid-template-columns: minmax(260px, 0.8fr) minmax(420px, 1.35fr);
    gap: 1rem;
    align-items: stretch;
  }

  .profile-card h1,
  .latest-posts-section h2 {
    margin-top: 0;
    margin-bottom: 0.4rem;
  }

  .profile-card h1 {
    white-space: nowrap;
    font-size: 1.55rem;
  }

  .profile-mark {
    width: 5.8rem;
    height: 5.8rem;
    display: block;
    margin-bottom: 0.5rem;
    border-radius: 50%;
    object-fit: cover;
    border: 1px solid color-mix(in srgb, var(--border-color) 82%, transparent);
    box-shadow: none;
  }

  .profile-lede,
  .profile-note,
  .post-row p,
  .preview-excerpt {
    color: var(--text-secondary);
  }

  .profile-actions {
    display: flex;
    gap: 0.8rem;
    flex-wrap: wrap;
    margin-top: 0.9rem;
  }

  .researcher-card {
    padding: 0.15rem 0 0.15rem 0.7rem;
    border-left: 2px solid color-mix(in srgb, var(--border-color) 86%, transparent);
    background: transparent;
    border-radius: 0;
    box-shadow: none;
  }

  .researcher-card .section-kicker {
    margin-bottom: 0.45rem;
  }

  .identity-list {
    display: grid;
    gap: 0.38rem;
    margin-top: 0.58rem;
  }

  .identity-list > div {
    display: grid;
    gap: 0.12rem;
  }

  .identity-label {
    color: var(--text-secondary);
    font-size: 0.74rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .researcher-card a {
    width: fit-content;
    background: none;
    padding: 0;
    box-shadow: none;
    transform: none;
    color: var(--text-primary);
    text-decoration: none;
    position: relative;
  }

  .researcher-card a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -0.08rem;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 0.2s ease;
  }

  .researcher-card a:hover,
  .researcher-card a:active {
    color: var(--text-primary);
    background: none;
    box-shadow: none;
    transform: none;
  }

  .researcher-card a:hover::after,
  .researcher-card a:active::after {
    transform: scaleX(1);
  }

  .primary-link {
    background: var(--text-primary);
    color: var(--background-color);
  }

  .primary-link:hover {
    background: var(--text-secondary);
  }

  .section-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.8rem;
  }

  .publication-section {
    position: relative;
    padding-bottom: 1.1rem;
    background: color-mix(in srgb, var(--background-color) 98%, var(--nice-div-color) 2%);
    border-style: solid;
  }

  .publication-header {
    margin-bottom: 1rem;
  }

  .publication-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--text-secondary);
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 0.3rem 0.55rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--nice-div-color) 72%, transparent);
  }

  .publication-lede {
    margin-bottom: 0.55rem;
    color: var(--text-primary);
  }

  .publication-copy p:last-child {
    margin-bottom: 0;
    color: var(--text-secondary);
  }

  .publication-minimal {
    margin-top: 0.8rem;
    padding-top: 0.85rem;
    border-top: 1px solid color-mix(in srgb, var(--border-color) 72%, transparent);
  }

  .publication-paper {
    display: grid;
    grid-template-columns: minmax(170px, 0.42fr) minmax(0, 1fr);
    gap: 1rem;
    margin-top: 0.9rem;
    padding-top: 0.95rem;
    border-top: 1px solid color-mix(in srgb, var(--border-color) 70%, transparent);
  }

  .publication-paper-cover {
    aspect-ratio: 4 / 5.4;
    overflow: hidden;
    border-radius: 16px;
    border: 1px solid color-mix(in srgb, var(--border-color) 72%, transparent);
    background: color-mix(in srgb, var(--nice-div-color) 82%, transparent);
  }

  .publication-paper-cover img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .publication-entry h3 {
    margin-top: 0;
    margin-bottom: 0.45rem;
  }

  .publication-line {
    margin-bottom: 0.25rem;
    color: var(--text-secondary);
  }

  .publication-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
  }

  .publication-hint {
    margin-top: 0.85rem;
    color: var(--text-secondary);
    font-size: 0.92rem;
  }

  .latest-posts-section {
    border-color: color-mix(in srgb, var(--border-color) 68%, transparent);
  }

  .post-list {
    display: grid;
    gap: 1rem;
  }

  .writing-stage {
    display: grid;
    grid-template-columns: minmax(480px, 1.55fr) minmax(180px, 0.42fr);
    gap: 1.15rem;
    align-items: stretch;
  }

  .post-row {
    display: grid;
    grid-template-columns: 140px minmax(0, 1fr);
    gap: 1rem;
    position: relative;
    overflow: hidden;
    min-height: 118px;
    border: 1px solid var(--border-color);
    border-radius: 18px;
    padding: 1rem 1.05rem;
    background: color-mix(in srgb, var(--background-color) 96%, var(--nice-div-color) 4%);
    cursor: pointer;
    transition: background-color 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
  }

  .post-row::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    pointer-events: none;
    opacity: 0;
    background:
      radial-gradient(120% 90% at 0% 0%, color-mix(in srgb, var(--background-color) 88%, transparent) 0%, transparent 52%),
      linear-gradient(180deg, color-mix(in srgb, var(--background-color) 66%, transparent), transparent 48%);
    transition: opacity 0.45s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .post-row.active {
    border-color: color-mix(in srgb, var(--border-color) 40%, var(--text-secondary) 60%);
    background: color-mix(in srgb, var(--background-color) 86%, var(--nice-div-color) 14%);
    box-shadow: 0 8px 18px rgba(0, 0, 0, 0.04);
  }

  .post-row:hover,
  .post-row:focus-within {
    border-color: color-mix(in srgb, var(--border-color) 32%, var(--text-secondary) 68%);
    background: color-mix(in srgb, var(--background-color) 90%, var(--nice-div-color) 10%);
    box-shadow: 0 12px 26px rgba(0, 0, 0, 0.055);
  }

  .post-row:hover::after,
  .post-row:focus-within::after,
  .post-row.active::after {
    opacity: 1;
  }

  .post-row-meta {
    color: var(--text-secondary);
    font-size: 0.84rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .post-row-body h3 {
    position: relative;
    margin-top: 0;
    margin-bottom: 0.35rem;
    line-height: 1.35;
    min-height: calc(1.35em * 2);
  }

  .post-row-body a {
    position: relative;
    display: inline-block;
    background: none;
    padding: 0;
    box-shadow: none;
    transform: none;
    color: var(--text-primary);
    text-decoration: none;
    line-height: 1.35;
    transition: color 0.22s ease;
  }

  .post-row-body a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -0.08rem;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 0.22s ease;
  }

  .post-row-body a:hover,
  .post-row-body a:active {
    color: var(--text-primary);
    background: none;
    box-shadow: none;
    transform: none;
  }

  .post-row:hover .post-row-body a,
  .post-row.active .post-row-body a,
  .post-row:focus-within .post-row-body a {
    color: var(--text-primary);
  }

  .post-row:hover .post-row-body a::after,
  .post-row.active .post-row-body a::after,
  .post-row:focus-within .post-row-body a::after,
  .post-row-body a:hover::after,
  .post-row-body a:active::after {
    transform: scaleX(1);
  }

  .post-row-body p,
  .post-row-body h3 {
    margin-bottom: 0;
  }

  .post-row-body {
    display: grid;
    align-content: start;
    min-height: 100%;
  }

  .post-row-body p {
    min-height: calc(1.55em * 2);
    line-height: 1.55;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .post-row.interactive-surface,
  .post-row.interactive-surface:hover,
  .post-row.interactive-surface:active {
    transform: none;
  }

  .post-row.interactive-surface::before {
    display: none;
  }

  .post-row > * {
    position: relative;
    z-index: 1;
  }

  .preview-stage-wrap {
    position: relative;
    min-height: 420px;
    padding-block: 2.6rem;
  }

  .preview-stage {
    position: relative;
    display: grid;
    grid-template-rows: 220px auto;
    min-height: 100%;
    overflow: hidden;
    border-radius: 20px;
    padding: 0;
    background: color-mix(in srgb, var(--background-color) 95%, var(--nice-div-color) 5%);
    box-shadow: 0 16px 32px rgba(0, 0, 0, 0.09);
  }

  .preview-stage.preview-animating .preview-image,
  .preview-stage.preview-animating .preview-content {
    animation: previewFade 0.7s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .preview-cover {
    aspect-ratio: 16 / 9;
    background: color-mix(in srgb, var(--nice-div-color) 76%, transparent);
  }

  .preview-image {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
  }

  .preview-content {
    padding: 0.85rem 0.85rem 1rem;
  }

  .preview-date {
    margin-top: 0;
    margin-bottom: 0.3rem;
    color: var(--text-secondary);
    font-size: 0.8rem;
  }

  .preview-title {
    margin-top: 0;
    margin-bottom: 0.45rem;
    font-size: clamp(1rem, 1.3vw, 1.2rem);
    line-height: 1.2;
  }

  .preview-excerpt {
    margin-bottom: 0;
    max-width: 14rem;
    font-size: 0.82rem;
    line-height: 1.55;
  }

  .preview-ghost {
    position: absolute;
    right: 0;
    width: 88%;
    height: 66px;
    border-radius: 14px;
    background-color: color-mix(in srgb, var(--nice-div-color) 90%, transparent);
    background-position: center;
    background-size: cover;
    filter: grayscale(1) saturate(0) brightness(0.86);
    opacity: 0.68;
    transform: scale(0.78);
    transition: background-image 0.55s ease, transform 0.55s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.55s ease;
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.08);
  }

  .preview-ghost::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: linear-gradient(180deg, rgba(255,255,255,0.2), rgba(120,120,120,0.28));
  }

  .preview-ghost-top {
    top: 0.25rem;
  }

  .preview-ghost-bottom {
    bottom: 0.25rem;
  }

  @keyframes previewFade {
    0% {
      opacity: 0;
      transform: translateY(14px);
    }
    100% {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 960px) {
    .home-layout {
      grid-template-columns: 1fr;
    }

    .home-sidebar {
      position: static;
      margin-left: 0;
    }

    .researcher-card {
      border-left-width: 0;
      padding-left: 0;
    }

    .writing-stage {
      grid-template-columns: 1fr;
    }

    .publication-paper {
      grid-template-columns: 1fr;
    }

    .preview-stage-wrap {
      min-height: auto;
      order: -1;
      padding-block: 0;
    }

    .preview-ghost {
      display: none;
    }
  }

  @media (max-width: 768px) {
    .post-row,
