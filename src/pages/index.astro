    align-items: stretch;
  }

  .profile-card h1 {
    margin-top: 0;
    margin-bottom: 0.18rem;
  }

  .publication-section h2,
  .latest-posts-section h2 {
    margin-top: 0;
    margin-bottom: 0.2rem;
    font-size: clamp(1.05rem, 1.5vw, 1.28rem);
    line-height: 1.2;
  }

  .profile-card h1 {
    white-space: nowrap;
    font-size: 1.34rem;
    line-height: 1.08;
  }

  .profile-header {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    align-items: center;
    text-align: center;
  }

  .profile-copy {
    min-width: 0;
  }

  .profile-mark {
    width: min(10.95rem, 100%);
    max-width: 100%;
    height: auto;
    aspect-ratio: 1 / 1;
    display: block;
    margin-bottom: 0;
    border-radius: 50%;
    object-fit: cover;
    border: 1px solid color-mix(in srgb, var(--border-color) 82%, transparent);
    box-shadow: none;
  }

  .profile-lede,
  .profile-affiliation,
  .profile-note,
  .post-row p,
  .preview-excerpt {
    color: var(--text-secondary);
  }

  .profile-affiliation {
    margin-bottom: 0;
    font-size: 0.8rem;
    line-height: 1.35;
  }

  .profile-actions {
    display: flex;
    gap: 0.8rem;
    flex-wrap: wrap;
    margin-top: 0.9rem;
  }

  .researcher-card {
    padding: 0.15rem 0 0.15rem 0.7rem;
    border-left: 2px solid color-mix(in srgb, var(--border-color) 86%, transparent);
    background: transparent;
    border-radius: 0;
    box-shadow: none;
  }

  .researcher-card .section-kicker {
    margin-bottom: 0.45rem;
  }

  .profile-links {
    display: grid;
    gap: 0.34rem;
    justify-items: start;
    margin-top: 0.82rem;
    font-size: 0.82rem;
    line-height: 1.35;
  }

  .researcher-card a {
    width: fit-content;
    background: none;
    padding: 0;
    box-shadow: none;
    transform: none;
    color: var(--text-primary);
    text-decoration: none;
    position: relative;
  }

  .profile-links a {
    display: inline-flex;
    align-items: center;
    gap: 0.38rem;
  }

  .profile-link-icon {
    width: 0.92rem;
    height: 0.92rem;
    flex: 0 0 auto;
