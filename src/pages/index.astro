  }

  .homepage-publication-authors,
  .homepage-publication-meta,
  .homepage-publication-description {
    margin-bottom: 0.18rem;
    color: var(--text-secondary);
  }

  .homepage-publication-meta {
    font-size: 0.82rem;
  }

  .homepage-publication-authors,
  .homepage-publication-description {
    font-size: 0.88rem;
    line-height: 1.4;
  }

  .homepage-publication-author {
    position: relative;
    display: inline-block;
  }

  .homepage-publication-author.is-self {
    color: var(--text-primary);
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .homepage-publication-author.is-self::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -0.08rem;
    height: 1px;
    background: color-mix(in srgb, var(--text-primary) 78%, transparent);
  }

  .homepage-publication-author-separator {
    color: color-mix(in srgb, var(--text-secondary) 84%, transparent);
  }

  .homepage-publication-description {
    display: -webkit-box;
    overflow: hidden;
    -webkit-line-clamp: 1;
    -webkit-box-orient: vertical;
  }

  .homepage-publication-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    margin-top: 0.32rem;
    font-size: 0.86rem;
  }

  .homepage-publication-footer {
    margin-top: 0.55rem;
    margin-bottom: 0;
  }

  .homepage-publication-links a,
  .homepage-publication-footer a {
    position: relative;
    display: inline-block;
    padding: 0;
    border-radius: 0;
    background: none;
    box-shadow: none;
    color: var(--text-secondary);
    text-decoration: none;
    transform: none;
    transition: color 0.22s ease;
  }

  .homepage-publication-links a::after,
  .homepage-publication-footer a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -0.08rem;
    height: 1px;
    background: currentColor;
