---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<BaseLayout title={`页面不存在 - ${SITE_TITLE}`} description={SITE_DESCRIPTION}>
  <div class="container page-shell narrow not-found-shell">
    <section class="content-card not-found">
      <p class="eyebrow">404</p>
      <h1>这个页面不存在。</h1>
      <p>这个链接可能已经失效，或者页面在网站重构过程中被移动了位置。</p>
      <p>
        你可以返回 <a href="/">首页</a>，浏览 <a href="/blog">文章列表</a>，或者查看 <a href="/feed.xml">RSS 订阅</a>。
      </p>
    </section>
  </div>
</BaseLayout>

<style>
  .not-found-shell {
    min-height: calc(100vh - 140px);
    align-content: center;
  }

  .eyebrow {
    margin-bottom: 0.5rem;
    color: var(--text-secondary);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-size: 0.82rem;
  }

  .not-found h1 {
    margin-top: 0;
    margin-bottom: 0.75rem;
  }
</style>
